# Copy to .env and fill in. Never commit .env.
#
# WARNING: every value here is inlined into the browser bundle by webpack and is
# readable by anyone who opens the built JS. These are public identifiers, not
# secrets. Keeping them out of the source tree only makes them easy to rotate
# per environment — real protection has to be configured at the provider:
#   - Maps key: restrict by HTTP referrer and to the Maps JavaScript API
#     (Google Cloud Console -> Credentials)
#   - EmailJS: set allowed origins and enable captcha (EmailJS dashboard)
#
# Never put a server-side secret (database URI, private API key) in this file.

# Google Maps JavaScript API key, used by the contacts map.
GOOGLE_MAPS_API_KEY=

# EmailJS identifiers for the contact form.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Google Analytics tracking ID. Leave empty to disable analytics.
GA_TRACKING_ID=
